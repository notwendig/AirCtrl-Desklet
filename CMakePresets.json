{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": { "AIRCTRL_TEST_WITH_DBUS": "OFF" }
    },
    {
      "name": "debug-server",
      "displayName": "Debug / server",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/DEBUG/server",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AIRCTRL_COMPONENT": "server",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "debug-client",
      "displayName": "Debug / client",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/DEBUG/client",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AIRCTRL_COMPONENT": "client",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release-server",
      "displayName": "Release / server",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/RELEASE/server",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AIRCTRL_COMPONENT": "server",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "release-client",
      "displayName": "Release / client",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/RELEASE/client",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AIRCTRL_COMPONENT": "client",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug-server", "configurePreset": "debug-server" },
    { "name": "debug-client", "configurePreset": "debug-client" },
    { "name": "release-server", "configurePreset": "release-server" },
    { "name": "release-client", "configurePreset": "release-client" }
  ],
  "testPresets": [
    { "name": "debug-client", "configurePreset": "debug-client", "output": { "outputOnFailure": true } },
    { "name": "release-client", "configurePreset": "release-client", "output": { "outputOnFailure": true } }
  ]
}
